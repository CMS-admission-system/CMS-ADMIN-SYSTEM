{
  "name": "cms-admin-portal",
  "version": "1.0.0",
  "private": true,
  "description": "College Admission System - Admin Portal (React Vite Frontend & FastAPI Backend)",
  "scripts": {
    "dev": "npm --prefix cms-admission-Frontend run dev",
    "build": "npm --prefix cms-admission-Frontend run build",
